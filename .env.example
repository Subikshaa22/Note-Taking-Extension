# Copy to .env and fill in the values marked REQUIRED.  cp .env.example .env
# docker-compose.yml already points AMQP_URL / REDIS_URL at the bundled containers.

# ---- LLM (REQUIRED) -------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Tried when the primary model is overloaded or rate-limited. Leave empty to disable.
LLM_FALLBACK_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SEC=120
# Transcripts longer than this (characters) are summarised in chunks and merged.
LLM_CHUNK_CHARS=60000
NOTES_LANGUAGE=English
MAX_FRAMES=8
MIN_FRAME_GAP_SEC=10

# ---- Global rate limits (shared by every worker) ----------------------------------
# Set these at or below your provider quotas; the queue then drains without 429s.
LLM_RPM=10
LLM_TPM=250000
NOTION_RPS=3
YOUTUBE_RPM=60

# ---- Retries and dead-letter queue -----------------------------------------------
# Attempts per stage before the job is DEAD_LETTERED, and the backoff between attempts
# (the last delay repeats). For a quick DLQ demo use e.g. MAX_ATTEMPTS=3, RETRY_DELAYS_SEC=3,6
MAX_ATTEMPTS=5
RETRY_DELAYS_SEC=10,30,90
LEASE_TTL_SEC=10
WORKER_CONCURRENCY=1

# ---- Security (REQUIRED) -----------------------------------------------------------
# Encrypts the Notion token inside queue messages. This is a development key only;
# generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=5TcflLAmWBpjHsdD28nHoAcg5OrG6prt1qKbAB7txi8=

# ---- Notion ----------------------------------------------------------------------
# Public integration credentials for the extension's "Connect Notion" OAuth button.
# Leave empty to use the extension's "paste an integration token" option instead.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Where pages go when a job has no notion_parent_id. Empty = the most recently edited
# top-level page shared with the integration.
NOTION_DEFAULT_PARENT_ID=
NOTION_VERSION=2022-06-28

# ---- Video limits and YouTube ---------------------------------------------------------
MAX_VIDEO_DURATION_SEC=1200
TRANSCRIPT_LANGUAGES=en,en-US,en-GB
FRAME_MAX_HEIGHT=720
FRAME_TIMEOUT_SEC=45
FRAME_CONCURRENCY=3
# Optional Netscape cookies file (mounted into the worker) if YouTube asks to sign in.
YTDLP_COOKIES_FILE=

# ---- Infrastructure (defaults match docker-compose.yml) -----------------------------
# AMQP_URL=amqp://notes:notes@rabbitmq:5672/
# REDIS_URL=redis://redis:6379/0
JOB_TTL_SEC=604800
LOG_LEVEL=INFO
