# Copy to .env and fill in the values marked REQUIRED.  cp .env.example .env
# docker-compose.yml already points AMQP_URL / REDIS_URL at the bundled containers.

# ---- LLM (REQUIRED) -------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Tried when the primary model is overloaded or rate-limited. Leave empty to disable.
LLM_FALLBACK_MODEL=gemini-3.8-flash
# Also Gemini's server-side deadline; below ~180 long notes fail with 504 "Deadline expired".
LLM_TIMEOUT_SEC=300
# Transcripts longer than this (characters) are summarised in chunks and merged.
LLM_CHUNK_CHARS=60000
NOTES_LANGUAGE=English
MAX_FRAMES=15
MIN_FRAME_GAP_SEC=10

# ---- Global rate limits (shared by every worker) ----------------------------------
# Set these at or below your provider quotas; the queue then drains without 429s.
LLM_RPM=10
LLM_TPM=250000
NOTION_RPS=3
YOUTUBE_RPM=60

# ---- Retries and dead-letter queue -----------------------------------------------
# Attempts per stage before the job is DEAD_LETTERED, and the backoff between attempts
# (the last delay repeats). For a quick DLQ demo use e.g. MAX_ATTEMPTS=3, RETRY_DELAYS_SEC=3,6
MAX_ATTEMPTS=5
RETRY_DELAYS_SEC=10,30,90
LEASE_TTL_SEC=10
WORKER_CONCURRENCY=1

# ---- Security (REQUIRED) -----------------------------------------------------------
# Encrypts the Notion token inside queue messages. This is a development key only;
# generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=5TcflLAmWBpjHsdD28nHoAcg5OrG6prt1qKbAB7txi8=

# ---- Notion ----------------------------------------------------------------------
# Public integration credentials for the extension's "Connect Notion" OAuth button.
# Leave empty to use the extension's "paste an integration token" option instead.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Where pages go when a job has no notion_parent_id. Empty = the most recently edited
# top-level page shared with the integration.
NOTION_DEFAULT_PARENT_ID=
NOTION_VERSION=2022-06-28

# ---- Video limits and YouTube ---------------------------------------------------------
MAX_VIDEO_DURATION_SEC=1200
TRANSCRIPT_LANGUAGES=en,en-US,en-GB
FRAME_MAX_HEIGHT=720
FRAME_TIMEOUT_SEC=45
FRAME_CONCURRENCY=3
# How screenshot moments are chosen. visual = scan the video (one low-res sample every
# FRAME_SCAN_INTERVAL_SEC) and let the vision model pick, for each state of the board/slides,
# the moment where it is most complete and least blocked by the presenter. The published
# images are always real, unedited frames captured from the video at those seconds.
# transcript = guess the moments from the transcript only (faster, no vision call).
FRAME_SELECTION=visual
FRAME_SCAN_INTERVAL_SEC=10
FRAME_SCAN_MAX_IMAGES=120
FRAME_SCAN_HEIGHT=360
FRAME_SCAN_TIMEOUT_SEC=600
# Time limit for the vision call that picks frames, and how many stage attempts may try it
# when the model times out or is overloaded before falling back to transcript-chosen frames
# (429s are always re-queued with backoff instead).
FRAME_SELECTION_TIMEOUT_SEC=240
VISUAL_SELECTION_ATTEMPTS=1
# Optional Netscape cookies file (mounted into the worker) if YouTube asks to sign in.
YTDLP_COOKIES_FILE=

# ---- Infrastructure (defaults match docker-compose.yml) -----------------------------
# AMQP_URL=amqp://notes:notes@rabbitmq:5672/
# REDIS_URL=redis://redis:6379/0
JOB_TTL_SEC=604800
# Per-video cache: the same video submitted again reuses its transcript, notes and frames
# (a new Notion page is still created). 0 turns it off, e.g. before a crash-recovery demo.
VIDEO_CACHE_TTL_SEC=604800
LOG_LEVEL=INFO

# ---- Fault injection for demos (probability per call, 0 = off) ----------------------------
# e.g. FAULT_LLM_429_RATE=0.5 shows 429 -> backoff -> retry; FAULT_FRAME_FAILURE_RATE=0.4
# shows COMPLETED_WITH_WARNINGS; FAULT_FRAME_FAILURE_RATE=1 shows a text-only page.
FAULT_LLM_429_RATE=0
FAULT_NOTION_429_RATE=0
FAULT_YOUTUBE_429_RATE=0
FAULT_FRAME_FAILURE_RATE=0
